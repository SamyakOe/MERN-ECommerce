# Database URL
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster_id>/<database_name>?retryWrites=true&w=majority

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key_change_this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_REFRESH_EXPIRY=7d

# ESEWA Payment Gateway (Test Mode)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=change_this_esewa_secret_key
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Khalti Payment Gateway
KHALTI_SECRET_KEY=change_this_khalti_secret_key
KHALTI_GATEWAY_URL=https://dev.khalti.com/api/v2/epayment

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173